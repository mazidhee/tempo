{
  "name": "habit-tracker",
  "version": "1.1.0",
  "description": "A local personal productivity workspace with habits, tasks and focus",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist": "npm run build && node scripts/package.cjs",
    "start": "electron .",
    "setup:desktop": "install-electron --no",
    "format": "prettier --write src tests scripts docs vite.config.mts",
    "test": "node scripts/test.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-electron": "1.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
