{
  "name": "habit-tracker",
  "version": "1.8.0",
  "description": "A local personal productivity workspace with habits, tasks and focus",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist": "npm run build && node scripts/package.cjs",
    "start": "electron .",
    "setup:desktop": "install-electron --no",
    "format": "prettier --write src tests scripts docs vite.config.mts",
    "test": "node scripts/test.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
